# CountKit on the Ultralytics image — torch + ultralytics + cv2 already inside.
#   x86 GPU (incl. Blackwell/RTX 5080): ultralytics/ultralytics:latest
#   Orin Nano / JetPack 6:              ultralytics/ultralytics:latest-jetson-jetpack6
ARG BASE=ultralytics/ultralytics:latest
FROM ${BASE}

# ffmpeg: reference-frame extraction. apt is idempotent, no need to probe first.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt ./
# ponytail: retry with --break-system-packages rather than sniff the base image's
# PEP-668 marker; drop the fallback once all bases ship a venv.
RUN pip install --no-cache-dir -r requirements.txt boto3 \
 || pip install --no-cache-dir --break-system-packages -r requirements.txt boto3

COPY *.py config.example.yaml ./
COPY static/ ./static/
COPY docs/ ./docs/
COPY tests/ ./tests/

# The operator's tree (config.yaml, ingest/, data/) is mounted here, never baked in.
ENV COUNTKIT_ROOT=/countkit \
    PYTHONUNBUFFERED=1
EXPOSE 8090
CMD ["python3", "app.py"]
