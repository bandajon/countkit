# CountKit on a DeepStream container — nvinfer + nvdcf through pyds.
#   x86 (Blackwell native): nvcr.io/nvidia/deepstream:9.1-triton-multiarch
#   Orin Nano / JetPack 6:  nvcr.io/nvidia/deepstream:7.1-triton-multiarch
ARG BASE=nvcr.io/nvidia/deepstream:7.1-triton-multiarch
FROM ${BASE}

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ffmpeg python3-pip python3-gi python3-gst-1.0 \
 && rm -rf /var/lib/apt/lists/*

# gstreamer1.0-libav & friends: DS 9.1+ containers ship without them, and no
# codec plugins means no decode of the operator's .mkv footage. The script's own
# failure is therefore the build's failure — never swallowed; only its absence
# (images that ship the plugins already) is acceptable.
RUN DS=/opt/nvidia/deepstream/deepstream; \
    if [ -f "$DS/user_additional_install.sh" ]; then \
        bash "$DS/user_additional_install.sh"; \
    else \
        echo "[countkit] no user_additional_install.sh in this image — assuming codecs are present"; \
    fi

# Alone in its layer: the pyds source build is a full bindings compile (~an hour on an
# Orin), and sharing a COPY with a CMD-time script would re-run it on every edit of it.
COPY docker/install_pyds.sh /usr/local/bin/
RUN bash /usr/local/bin/install_pyds.sh

WORKDIR /app
COPY requirements.txt ./
# ponytail: see Dockerfile.yolo — same PEP-668 fallback.
RUN pip3 install --no-cache-dir -r requirements.txt boto3 \
 || pip3 install --no-cache-dir --break-system-packages -r requirements.txt boto3

COPY *.py config.example.yaml ./
COPY static/ ./static/
COPY docs/ ./docs/
COPY tests/ ./tests/
COPY docker/setup_model.sh /usr/local/bin/

ENV COUNTKIT_ROOT=/countkit \
    PYTHONUNBUFFERED=1
EXPOSE 8090
# Model setup is advisory: an operator with their own nvinfer_config still gets a UI.
CMD ["bash", "-c", "bash /usr/local/bin/setup_model.sh || echo '[countkit] model setup failed — set nvinfer_config in config.yaml yourself'; exec python3 app.py"]
